{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/health/database",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/v1/bookings/notification-sweep",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/v1/bookings/retry-due-notifications",
      "schedule": "*/15 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
