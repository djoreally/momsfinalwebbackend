{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/health/database",
      "schedule": "0 12 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": true
  }
}
